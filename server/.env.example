# Local SQLite file. Relative paths are resolved from the server working directory.
DB_PATH=./data/matzip.sqlite
DB_SYNCHRONIZE=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCRESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
PORT=3030

# Production only: comma-separated origins.
CORS_ORIGINS=

# Naver Local Search API (server only)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Social login
GOOGLE_CLIENT_ID=

# Korea Tourism Organization TourAPI (free public-data key)
# https://www.data.go.kr/data/15101578/openapi.do
TOUR_API_SERVICE_KEY=

# Seoul Open Data Plaza (separate free key; Seoul restaurants only)
# https://data.seoul.go.kr/
SEOUL_OPEN_DATA_API_KEY=

# Ministry of the Interior and Safety good-price stores (falls back to TourAPI key)
GOOD_PRICE_API_SERVICE_KEY=
GOOD_PRICE_API_URL=
