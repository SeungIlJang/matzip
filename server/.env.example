# Local SQLite file. Relative paths are resolved from the server working directory.
DB_PATH=./data/matzip.sqlite
DB_SYNCHRONIZE=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCRESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
PORT=3030

# Production only: comma-separated origins.
CORS_ORIGINS=

# Naver Local Search API (server only)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Social login
GOOGLE_CLIENT_ID=
